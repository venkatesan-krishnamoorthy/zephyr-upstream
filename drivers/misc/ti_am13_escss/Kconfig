config TI_AM13_ESCSS
	bool "TI AM13 EtherCAT Subsystem (ESCSS) driver"
	default y
	depends on DT_HAS_TI_AM13_ESCSS_ENABLED
	select PINCTRL
	help
	  Enable the driver for the EtherCAT Subsystem of TI AM13 devices.
	  It brings up the subsystem and provides access to the Beckhoff ESC
	  register and process data space for an EtherCAT slave stack.

if TI_AM13_ESCSS

config TI_AM13_ESCSS_INIT_PRIORITY
	int "ESCSS init priority"
	default KERNEL_INIT_PRIORITY_DEVICE
	help
	  ESCSS driver initialization priority. If the SII EEPROM is emulated
	  through an internal I2C target, the target must be ready before
	  this driver waits for the EEPROM load.

endif # TI_AM13_ESCSS
